# Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=

# Pipe-separated list of regex patterns (each matched with re.search)
# Examples:
#   secret                          -> literal substring "secret"
#   (?i)secret                     -> case-insensitive "secret"
#   secret||banned||spoiler        -> any of these literal substrings
#   (?i)\b(secret|banned)\b        -> case-insensitive whole-word match
#   \d{4}-\d{4}                    -> patterns like 1234-5678
TRIGGER_PATTERNS=nigger||faggot||fag||kike||jew||muslim||tranny||trannies||jew||furfag||troon||negro||niger||nigga||indian||pajeet||shitskin||